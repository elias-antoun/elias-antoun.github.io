---
import Button from './ui/Button.astro';
import { profile, socials, stats } from '../data/site';
import { obfuscateEmail } from '../lib/email';

const email = obfuscateEmail(socials[0].handle, 'outlook.com');
const externalSocials = socials.filter((s) => s.href.startsWith('http'));
---

<section id="top" class="border-b border-border">
  <div class="mx-auto w-full max-w-5xl px-6 py-20 sm:py-28">
    <h1 class="wordmark text-4xl leading-[1.05] sm:text-6xl lg:text-7xl">{profile.name}</h1>
    <p class="mt-4 font-mono text-base text-muted sm:text-xl">{profile.title}</p>

    <p class="mt-6 max-w-2xl leading-relaxed text-muted">{profile.positioning}</p>

    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
      {
        stats.map((stat) => (
          <div>
            <dt class="font-mono text-2xl font-medium text-accent">{stat.value}</dt>
            <dd class="mt-1 text-xs text-muted">{stat.label}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <Button href={email.href}>Get in touch</Button>
      <Button href="/Elias_Antoun_Resume.pdf" variant="secondary" download>Download CV</Button>
      {
        externalSocials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-muted transition-colors duration-150 hover:text-accent"
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

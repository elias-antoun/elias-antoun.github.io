---
import ThemeToggle from './ThemeToggle.astro';
import { nav } from '../data/site';
---

<header
  class="sticky top-0 z-10 -mx-6 flex items-center justify-between gap-4 border-b border-rule bg-paper px-6 py-3"
>
  <a href="#main" class="display text-sm" style="font-stretch: 125%">EA</a>

  <nav aria-label="Sections" class="hidden gap-5 sm:flex">
    {
      nav.map((item) => (
        <a
          href={`#${item.id}`}
          data-nav-link={item.id}
          class="font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-ink-soft transition-colors duration-150 hover:text-ink aria-[current=true]:text-signal"
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center gap-3">
    <a
      href="/Elias_Antoun_Resume.pdf"
      download
      class="font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-ink underline decoration-rule underline-offset-4 transition-colors duration-150 hover:text-signal hover:decoration-signal"
    >
      CV
    </a>
    <ThemeToggle />
  </div>
</header>

<script>
  // Scroll-spy: mark the nav link whose section is currently in view.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const byId = new Map<string, HTMLAnchorElement>();
  links.forEach((link) => {
    const id = link.dataset.navLink;
    if (id) byId.set(id, link);
  });

  const sections = [...byId.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0 && 'IntersectionObserver' in window) {
    // A generous band: sections are tall, and a narrow band leaves the nav
    // unmarked whenever a section boundary sits outside it.
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length === 0) return;
        byId.forEach((link) => link.removeAttribute('aria-current'));
        byId.get(visible[0].target.id)?.setAttribute('aria-current', 'true');
      },
      { rootMargin: '-72px 0px -55% 0px', threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

---
import ThemeToggle from './ThemeToggle.astro';
import { nav } from '../data/site';
---

<header class="sticky top-0 z-20 border-b border-border bg-bg/95 backdrop-blur">
  <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-6 py-3.5">
    <a href="#top" class="text-sm font-bold tracking-tight">Elias Antoun</a>

    <nav aria-label="Sections" class="hidden gap-6 md:flex">
      {
        nav.map((item) => (
          <a
            href={`#${item.id}`}
            data-nav-link={item.id}
            class="text-sm text-muted transition-colors duration-150 hover:text-text aria-[current=true]:font-medium aria-[current=true]:text-accent"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="/Elias_Antoun_Resume.pdf"
        download
        class="rounded-md border border-border px-3 py-1.5 text-sm font-medium transition-colors duration-150 hover:border-accent hover:text-accent"
      >
        CV
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  // Scroll-spy: mark the nav link whose section is currently in view.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const byId = new Map<string, HTMLAnchorElement>();
  links.forEach((link) => {
    const id = link.dataset.navLink;
    if (id) byId.set(id, link);
  });

  const sections = [...byId.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length === 0) return;
        byId.forEach((link) => link.removeAttribute('aria-current'));
        byId.get(visible[0].target.id)?.setAttribute('aria-current', 'true');
      },
      { rootMargin: '-72px 0px -55% 0px', threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

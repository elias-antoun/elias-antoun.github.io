---
import Section from './Section.astro';
import { education, certifications } from '../data/site';
---

<Section id="education" index="06" heading="Education &amp; Certifications">
  <article class="sm:grid sm:grid-cols-[9rem_1fr] sm:gap-6">
    <p class="font-mono text-xs text-muted sm:pt-1">{education.period}</p>
    <div class="mt-2 sm:mt-0">
      <h3 class="font-semibold">{education.institution}</h3>
      <p class="mt-1 text-sm text-muted">{education.degree}</p>
      <ul class="mt-3 space-y-1">
        {education.highlights.map((item) => <li class="font-mono text-xs text-accent">{item}</li>)}
      </ul>
    </div>
  </article>

  <div class="mt-10 space-y-6">
    {
      certifications.map((cert) => (
        <article class="sm:grid sm:grid-cols-[9rem_1fr] sm:gap-6">
          <p class="font-mono text-xs text-muted sm:pt-0.5">{cert.date}</p>
          <div class="mt-1 sm:mt-0">
            <h4 class="text-sm font-medium">
              {cert.name} <span class="text-muted">· {cert.issuer}</span>
            </h4>
            <p class="mt-1 text-sm text-muted">{cert.detail}</p>
          </div>
        </article>
      ))
    }
  </div>
</Section>

---
import Section from './Section.astro';
import { education, certifications } from '../data/site';
---

<Section id="education" eyebrow="Academics" heading="Education & Certifications" alt>
  <article class="card p-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-lg font-semibold tracking-tight">{education.institution}</h3>
      <span class="font-mono text-xs text-muted">{education.period}</span>
    </div>
    <p class="mt-1.5 text-sm text-muted">{education.degree}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {education.highlights.map((item) => <li class="chip">{item}</li>)}
    </ul>
  </article>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    {
      certifications.map((cert) => (
        <article class="card p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h4 class="text-sm font-semibold">{cert.name}</h4>
            <span class="font-mono text-xs text-muted">{cert.date}</span>
          </div>
          <p class="mt-0.5 text-xs text-muted">{cert.issuer}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{cert.detail}</p>
        </article>
      ))
    }
  </div>
</Section>

---
import Section from './Section.astro';
import { experience, universityRoles } from '../data/site';
---

<Section
  id="experience"
  eyebrow="Career"
  heading="Experience"
  lede="Two completed 2026 internships, alongside teaching and society work running since 2023."
>
  <div class="space-y-6">
    {
      experience.map((role) => (
        <article class="card p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-lg font-semibold tracking-tight">
              {role.title}
              <span class="font-normal text-muted"> · {role.org}</span>
            </h3>
            <span class="font-mono text-xs text-muted">{role.period}</span>
          </div>

          {role.metrics.length > 0 && (
            <dl class="mt-5 grid grid-cols-1 gap-4 rounded-lg bg-bg-alt p-4 sm:grid-cols-3">
              {role.metrics.map((metric) => (
                <div>
                  <dt class="font-mono text-base font-medium text-accent">{metric.value}</dt>
                  <dd class="mt-1 text-xs text-muted">{metric.label}</dd>
                </div>
              ))}
            </dl>
          )}

          <ul class="mt-5 space-y-2.5">
            {role.bullets.map((bullet) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="mt-10">
    <h3 class="text-sm font-semibold tracking-tight">Alongside</h3>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {
        universityRoles.map((role) => (
          <article class="card p-5">
            <span class="font-mono text-xs text-muted">{role.period}</span>
            <h4 class="mt-2 text-sm font-semibold">{role.title}</h4>
            <p class="mt-0.5 text-xs text-muted">{role.org}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{role.summary}</p>
          </article>
        ))
      }
    </div>
  </div>
</Section>

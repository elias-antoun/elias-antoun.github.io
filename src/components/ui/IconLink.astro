---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
const external = href.startsWith('http');
---

<a
  href={href}
  aria-label={label}
  class="font-mono text-xs text-ink-soft underline decoration-rule decoration-1 underline-offset-4 transition-colors duration-150 hover:text-signal hover:decoration-signal"
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
</a>

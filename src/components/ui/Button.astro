---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  download?: boolean;
}
const { href, variant = 'primary', download = false } = Astro.props;

const base =
  'inline-flex items-center gap-2 rounded-sm px-4 py-2.5 text-sm font-medium transition-colors duration-150';
const styles = {
  primary: 'bg-signal text-on-signal hover:opacity-88',
  secondary: 'border border-rule text-ink hover:border-signal hover:text-signal',
};
---

<a href={href} class={`${base} ${styles[variant]}`} {...download ? { download: true } : {}}>
  <slot />
</a>

---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import { partitionProjects } from '../lib/projects';

const entries = await getCollection('projects');
const { featured, compact } = partitionProjects(entries);

// The readout counts real things rather than numbering the section.
const publicRepos = entries.filter((e) => e.data.links?.repo).length;
const meta = `${entries.length} projects · ${publicRepos} public repos`;
---

<Section id="projects" heading="Projects" meta={meta}>
  <div class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>

  {
    compact.length > 0 && (
      <div class="mt-14 border-t border-rule pt-6">
        <h3 class="readout mb-4">Also built · coursework</h3>
        <ul class="space-y-3">
          {compact.map((project) => (
            <li class="flex flex-wrap items-baseline gap-x-3">
              <span class="text-sm font-medium">{project.data.title}</span>
              <span class="font-mono text-[0.6875rem] text-ink-soft">
                {project.data.tags.join(' · ')}
              </span>
              <span class="w-full text-xs text-ink-soft sm:w-auto sm:flex-1">
                {project.data.summary}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Section>

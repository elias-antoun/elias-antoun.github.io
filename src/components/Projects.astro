---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import { partitionProjects } from '../lib/projects';

const entries = await getCollection('projects');
const { featured, compact } = partitionProjects(entries);
---

<Section
  id="projects"
  eyebrow="Builds"
  heading="Projects"
  lede="Machine learning, robotics and embedded work, from coursework prototypes to internship systems."
  alt
>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>

  {
    compact.length > 0 && (
      <div class="mt-10">
        <h3 class="text-sm font-semibold tracking-tight">Also built</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {compact.map((project) => (
            <article class="card p-5">
              <h4 class="text-sm font-semibold">{project.data.title}</h4>
              <p class="mt-2 text-sm leading-relaxed text-muted">{project.data.summary}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.data.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    )
  }
</Section>

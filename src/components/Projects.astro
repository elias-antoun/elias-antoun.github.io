---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import { partitionProjects } from '../lib/projects';

const entries = await getCollection('projects');
const { featured, compact } = partitionProjects(entries);
---

<Section id="projects" index="04" heading="Projects">
  <div class="grid gap-6 sm:grid-cols-2">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>

  {
    compact.length > 0 && (
      <>
        <h3 class="mt-12 font-mono text-xs uppercase tracking-wide text-muted">Also built</h3>
        <ul class="mt-4 divide-y divide-border">
          {compact.map((project) => (
            <li class="py-3">
              <div class="flex flex-wrap items-baseline gap-x-3">
                <span class="text-sm font-medium">{project.data.title}</span>
                <span class="font-mono text-xs text-muted">{project.data.tags.join(' · ')}</span>
              </div>
              <p class="mt-1 text-xs text-muted">{project.data.summary}</p>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Section>

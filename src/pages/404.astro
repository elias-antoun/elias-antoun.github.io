---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Elias Antoun" description="This page does not exist.">
  <main id="main" class="mx-auto w-full max-w-5xl px-6 py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-md leading-relaxed text-muted">
      That address does not resolve to anything on this site.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
    >
      <span aria-hidden="true">&larr;</span>
      Back to the portfolio
    </a>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Elias Antoun" description="This page does not exist.">
  <main id="main" class="py-24">
    <p class="readout">No signal</p>
    <h1 class="display mt-4 text-[clamp(2rem,6vw,3.25rem)]">Page not found</h1>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-soft">
      That address does not resolve to anything on this site.
    </p>
    <a
      href="/"
      class="mt-7 inline-block font-mono text-xs text-signal underline decoration-1 underline-offset-4 hover:no-underline"
    >
      Back to the portfolio
    </a>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../data/site';
---

<Layout title={`${profile.name} — ${profile.title}`} description={profile.positioning}>
  <main id="main">
    <ThemeToggle />
    <h1>{profile.name}</h1>
  </main>
</Layout>
